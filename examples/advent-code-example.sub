let mod = fn x n -> x - ((x / n) * n);
let neg = fn n -> 0 - n;
let not = fn cond -> if cond then false else true;

let is_int = fn ascii -> if (ascii >= 48) and (ascii <= 57) then true else false;
# find the index after the first non numeric integer
let index_numeric = fn str n ->
  if (n < len(str,)) and is_int(getc(str, n,),) then
    index_numeric(str, n + 1,)
  else n
;
